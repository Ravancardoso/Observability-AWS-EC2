# ════════════════════════════════════════════════════════════
#  Dive Realities — Observability Stack
#  Copie para .env e preencha antes de rodar: make up
# ════════════════════════════════════════════════════════════

# ── Geral ────────────────────────────────────────────────
ENVIRONMENT=prod

# ── Prometheus ───────────────────────────────────────────
PROMETHEUS_RETENTION=30d                  # histórico de métricas (ajuste conforme disco disponível)

# ── Loki ─────────────────────────────────────────────────
LOKI_RETENTION=720h                       # histórico de logs (720h = 30 dias)

# ── Tailscale — IPs privados da VPN ──────────────────────
# Execute `tailscale ip -4` em cada VPS após o join para obter o IP
OBS_TAILSCALE_IP=100.x.x.x               # IP Tailscale da VPS de observabilidade
DEV_TAILSCALE_IP=100.x.x.x               # IP Tailscale da VPS dev
PROD_TAILSCALE_IP=100.x.x.x              # IP Tailscale da VPS prod

# ── PM2 Exporter ─────────────────────────────────────────
PM2_EXPORTER_HOST=172.17.0.1             # IP da bridge docker0 no Linux (ip addr show docker0)
PM2_EXPORTER_PORT=9209
PM2_LOGS_PATH=/root/.pm2/logs            # caminho real dos logs do PM2 no host

# ── Grafana / Caddy ──────────────────────────────────────
# Caddy emite certificado Let's Encrypt automaticamente para este domínio
GRAFANA_DOMAIN=grafana.diverealities.com.br
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=TROCAR_PARA_SENHA_FORTE   # use: openssl rand -base64 32
GRAFANA_ROOT_URL=https://grafana.diverealities.com.br

# ── Alertmanager: Discord ─────────────────────────────────
# Crie 3 webhooks no Discord e cole as URLs abaixo
DISCORD_WEBHOOK_PROD_CRITICAL=https://discord.com/api/webhooks/PREENCHER/prod-critico
DISCORD_WEBHOOK_PROD_WARNING=https://discord.com/api/webhooks/PREENCHER/prod-atencao
DISCORD_WEBHOOK_DEV=https://discord.com/api/webhooks/PREENCHER/dev
